pipeline {
    agent any

    parameters {
        string(
            name: 'AWS_ACCOUNT_ID',
            defaultValue: '250326384271',
            description: 'AWS Account ID'
        )
        string(
            name: 'AWS_REGION',
            defaultValue: 'us-east-1',
            description: 'AWS Region'
        )
        string(
            name: 'ECR_REPO_NAME',
            defaultValue: 'expenses-manager',
            description: 'ECR Repository Name'
        )
        string(
            name: 'IMAGE_TAG',
            defaultValue: 'latest',
            description: 'Docker image tag to deploy'
        )
        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'staging', 'prod'],
            description: 'Target deployment environment'
        )
    }

    environment {
        AWS_DEFAULT_REGION = "${params.AWS_REGION}"
        ECR_URI            = "${params.AWS_ACCOUNT_ID}.dkr.ecr.${params.AWS_REGION}.amazonaws.com/${params.ECR_REPO_NAME}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Deploy to AWS') {
            steps {
                echo "Deploying ${ECR_URI}:${params.IMAGE_TAG} to ${params.ENVIRONMENT}..."
                script {
                    def infraDir = "../infra/environments/${params.ENVIRONMENT}"
                    if (fileExists(infraDir)) {
                        dir(infraDir) {
                            sh """
                                terraform init
                                terraform apply -auto-approve -var="image_tag=${params.IMAGE_TAG}"
                            """
                        }
                    } else {
                        echo "Running deployment command for ${params.ENVIRONMENT}..."
                        // e.g. sh "aws ecs update-service --cluster app-cluster --service app-service --force-new-deployment"
                    }
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        success {
            echo "Deploy job succeeded for tag: ${params.IMAGE_TAG} on ${params.ENVIRONMENT}"
        }
        failure {
            echo "Deploy job failed. Check console output."
        }
    }
}
